@startuml ingestion-pipeline
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LANDSCAPE()
LAYOUT_WITH_LEGEND()

title Customer-Facing Logs — Ingestion Pipeline

System_Ext(ai_edge, "AI Edge Data Plane", "Envoy + WAF sidecar. HTTPProxy controller stamps org_id, project_id, and resource identity into Envoy xDS access log config at reconcile time — no per-record catalog lookup.")

System_Ext(compute, "Compute Workloads", "Unikraft VMs on Kraftlet nodes. OTel Collector DaemonSet (contrib) scrapes /var/log/pods via filelog receiver. k8sattributes processor reads datum.org_id and datum.project_id from pod labels stamped by unikraft-provider.")

System_Ext(catalog, "Telemetry Catalog", "LogDefinition and MonitoredResourceType CRDs published by the telemetry-services-operator. Defines legal log IDs and resource attribute vocabulary per resource type.")

System_Boundary(edge, "Edge Cluster") {
    Container(gateway, "OTLP Gateway", "Go service", "Validates org_id and project_id are present. Validates log_id against cached LogDefinition (Kubernetes informer, no API call per record). Validates resource attribute vocabulary. Publishes one NATS message per record.")
    ContainerQueue(nats_edge, "NATS Edge", "NATS leaf node", "Buffers records; forwards to hub via leaf node connection. Provides backpressure if hub is slow.")
}

System_Boundary(hub, "Hub Cluster") {
    ContainerQueue(nats_hub, "NATS Hub", "NATS JetStream", "Durable stream per subject telemetry.logs.<org_id>.<project_id>.<log_id>. ClickHouse pulls directly; live-tail handler subscribes independently.")
    ContainerDb(clickhouse, "ClickHouse", "platform_logs (MergeTree)", "logs_ingest table uses ENGINE=NATS to pull from JetStream. Materialized view extracts columns into platform_logs. Partitioned by (org_id, month). Sorted by (org_id, project_id, resource_type, resource_name, log_id, timestamp). TTL 7 days.")
}

Rel(ai_edge, gateway, "OTLP/HTTP log records", "OTLP")
Rel(compute, gateway, "OTLP/HTTP log records", "OTLP")
Rel(gateway, catalog, "Validate log_id and attribute vocabulary", "informer cache")
Rel(gateway, nats_edge, "Publish one message per record", "NATS")
Rel(nats_edge, nats_hub, "Leaf node forwarding", "NATS")
Rel(nats_hub, clickhouse, "Pull via NATS engine table", "JetStream")

@enduml
